# --- S3 (MinIO) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=test-bucket
MINIO_SECURE=false

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=test-collection
# Размерность векторов (должна совпадать с моделью эмбеддингов, для BAAI/bge-m3 — 1024)
QDRANT_VECTOR_SIZE=1024
QDRANT_USE_HTTPS=false

# --- Соседние сервисы (базовые URL, без путей) ---
# file_to_text_converter_server
TEXT_CONVERTER_URL=http://localhost:8999
# chunk_n_vec_server
CHUNK_N_VEC_URL=http://localhost:8998

# --- Параметры синхронизации ---
SYNC_INTERVAL_MINUTES=30
# Сколько файлов обрабатывать одновременно
MAX_CONCURRENT_FILES=1
# Параметры чанкинга (в символах)
CHUNK_MAX_SIZE=4000
CHUNK_OVERLAP=500
# Таймаут обработки одного файла соседними сервисами, секунды
REQUEST_TIMEOUT=1200
MAX_RETRIES=3
# Как часто /health реально опрашивает зависимости, секунды
HEALTH_CHECK_INTERVAL=150

SERVICE_PORT=8997
LOG_LEVEL=INFO
